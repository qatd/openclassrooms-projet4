meta {
  name: Create session
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/session
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Bruno test session",
    "date": "2026-12-01T10:00:00.000Z",
    "description": "Session created by the Bruno collection",
    "teacherId": {{teacherId}}
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  // Session reused by the next requests and deleted at the end
  bru.setVar("sessionId", res.body.id);
}
