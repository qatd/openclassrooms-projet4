meta {
  name: Register
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{registerEmail}}",
    "password": "password123",
    "firstName": "Bruno",
    "lastName": "Test"
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  // Unique email so the request can be replayed without "Email already exists"
  bru.setVar("registerEmail", `bruno-${Date.now()}@test.com`);
}

script:post-response {
  // This user is used by the "user" folder and deleted at the end
  bru.setVar("userToken", res.body.token);
  bru.setVar("userId", res.body.id);
}
