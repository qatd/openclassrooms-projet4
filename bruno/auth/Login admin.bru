meta {
  name: Login admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "yoga@studio.com",
    "password": "test!1234"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  // Token reused by every request (collection auth)
  bru.setVar("adminToken", res.body.token);
}
